# Generated Safari app wrapper — produced locally by
# xcrun safari-web-extension-converter, never committed.
SafariProject/

# macOS
.DS_Store
._*

# Xcode — per-user state and build artifacts
xcuserdata/
*.xcuserstate
*.xcuserdatad
build/
DerivedData/

# Test dependencies. The extension itself has no build step and ships from
# extension/ as plain files; node_modules exists only for the test harness.
node_modules/

# Local tooling workspaces — scanner state and agent scratch, regenerated by
# their respective tools and of no use to anyone cloning this repo.
.tidy/
.deepsec/
.claude/

# Signing / secrets — never commit anything signable
*.mobileprovision
*.provisionprofile
*.p12
*.cer
